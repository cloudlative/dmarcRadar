generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

enum SourceType {
  UPLOAD
  EMAIL
}

enum Disposition {
  none
  quarantine
  reject
}

enum AuthResult {
  pass
  fail
  softfail
  neutral
  none
  temperror
  permerror
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(VIEWER)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model Domain {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  reports     Report[]
}

model MailboxConfig {
  id                 String   @id @default(cuid())
  name               String   @unique
  host               String
  port               Int      @default(993)
  secure             Boolean  @default(true)
  username           String
  passwordEncrypted  String
  folder             String   @default("INBOX")
  pollIntervalMinutes Int     @default(15)
  lastPolledAt       DateTime?
  // Set on every poll attempt, success or failure, and cleared on success — so a failed poll
  // (bad credentials, unreachable host, timeout) is visible after a page refresh instead of
  // only in a toast that vanishes the moment the tab is closed.
  lastPollError      String?
  // Ingestion progress tracked by IMAP UID rather than the \Seen flag — \Seen is shared
  // mailbox state that a human or another mail client can silently change, causing reports
  // to be skipped. uidValidity resets lastUid to re-scan from the start if the mailbox is
  // recreated (per IMAP spec, UIDs are only stable within a given uidValidity epoch).
  lastUid            Int?
  uidValidity        BigInt?
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Report {
  id               String      @id @default(cuid())
  domain           Domain      @relation(fields: [domainId], references: [id])
  domainId         String
  orgName          String
  email            String?
  reportId         String
  dateRangeBegin   DateTime
  dateRangeEnd     DateTime
  policyDomain     String
  policyAdkim      String?
  policyAspf       String?
  policyP          String?
  policySp         String?
  policyPct        Int?
  sourceType       SourceType
  rawXmlPath       String?
  createdAt        DateTime    @default(now())
  records          Record[]

  @@unique([reportId, orgName, domainId])
  @@index([domainId])
  @@index([dateRangeBegin, dateRangeEnd])
}

model Record {
  id              String      @id @default(cuid())
  report          Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId        String
  sourceIp        String
  count           Int
  disposition     Disposition
  dkimResult      AuthResult
  spfResult       AuthResult
  headerFrom      String?
  envelopeFrom    String?
  envelopeTo      String?
  dkimDomain      String?
  dkimSelector    String?
  dkimAuthResult  AuthResult?
  spfDomain       String?
  spfAuthResult   AuthResult?

  @@index([reportId])
  @@index([sourceIp])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  target    String?
  createdAt DateTime @default(now())
}
