# Postgres
DATABASE_URL="postgresql://dmarc:dmarc@localhost:5432/dmarc_reports?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Used to encrypt IMAP mailbox passwords at rest (32-byte hex, e.g. `openssl rand -hex 32`)
MAILBOX_SECRET="change-me-32-byte-hex-0000000000000000000000000000000000"

# Seed script — creates the first admin user on `npm run seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Where raw uploaded/ingested report XML is archived on disk
REPORTS_STORAGE_DIR="./storage/reports"
