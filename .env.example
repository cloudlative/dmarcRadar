# Postgres — used two ways:
# 1. DATABASE_URL below is read directly by Prisma/Next.js for local (non-Docker) use, where
#    Postgres's port is published to the host, so the hostname is `localhost`.
# 2. POSTGRES_USER/PASSWORD/DB are read by docker-compose: the `postgres` service uses them
#    directly as its own credentials, and the `app`/`worker` services use them to build a
#    DATABASE_URL that points at the `postgres` service by name instead of `localhost` (which,
#    inside a container, would mean the container itself, not the Postgres one). Change these
#    three and the containerized DATABASE_URL follows automatically — just keep DATABASE_URL
#    above in sync too if you also run things locally against the same credentials.
DATABASE_URL="postgresql://dmarc:dmarc@localhost:5432/dmarc_reports?schema=public"
POSTGRES_USER="dmarc"
POSTGRES_PASSWORD="dmarc"
POSTGRES_DB="dmarc_reports"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Used to encrypt IMAP mailbox passwords at rest (32-byte hex, e.g. `openssl rand -hex 32`)
MAILBOX_SECRET="change-me-32-byte-hex-0000000000000000000000000000000000"

# Seed script — creates the first admin user on `npm run seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Where raw uploaded/ingested report XML is archived on disk
REPORTS_STORAGE_DIR="./storage/reports"
